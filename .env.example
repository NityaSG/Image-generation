# Azure OpenAI endpoint exposing the v1-compat surface (used with the standard OpenAI SDK).
AZURE_GPT_IMAGE_ENDPOINT=https://ich-uk-new-resource.services.ai.azure.com/openai/v1
AZURE_GPT_IMAGE_KEY=your-azure-api-key-here
AZURE_GPT_IMAGE_DEPLOYMENT=gpt-image-2

# Optional: absolute path to ICH-Next/Colour_analysis. Leave blank to use the
# default (../ICH-Next/Colour_analysis relative to the POC folder).
COLOUR_ANALYSIS_PATH=

# Comma-separated list of allowed origins for the FastAPI backend.
# Use * during development. Tighten in production (e.g. https://your-domain.com).
CORS_ORIGINS=*
